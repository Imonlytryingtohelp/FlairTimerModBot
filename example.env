# Reddit Bot Credentials
FTMB_USERNAME=your_reddit_username
FTMB_PASSWORD=your_reddit_password
FTMB_CLIENT_ID=your_client_id
FTMB_CLIENT_SECRET=your_client_secret
FTMB_USER_AGENT="FlairTimerModBot/1.2.0"

# Subreddit Configuration
FTMB_SUBREDDIT=your_subreddit

# Bot Polling Configuration
FTMB_INTERVAL=30
FTMB_SEARCHLIMIT=600

# Wiki Configuration
# Set to true to load flair timer configs from subreddit wiki (recommended)
FTMB_USE_WIKI_CONFIG=true

# Name of the wiki page containing flair timer configurations
# Page should contain YAML formatted flair timer configs
# Default: flair-timers
# Full URL: https://reddit.com/r/your_subreddit/wiki/flair-timers
FTMB_WIKI_PAGE=flair-timers
